{
  "manifest_version": 2,
  "name": "GIR Clipper",
  "version": "1.3",
  "description": "Send the current page to GIR to save as a bookmark",
  "permissions": [
    "activeTab",
    "storage",
    "https://vootcruiser.lupine.org/*"
  ],
  "browser_action": {
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Save page with GIR",
    "default_popup": "popup.html"
  },
  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
